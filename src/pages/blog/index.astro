---
import BaseLayout from '../../layouts/BaseLayout.astro';

// BASE_URL es '/' en local y '/nombre-repo/' al publicar en GitHub Pages.
const base = import.meta.env.BASE_URL;

const articulos = [
  {
    title: 'El café de especialidad: mucho más que una taza',
    href: 'blog/articulo-1/',
    description: 'Descubre el origen, la calidad y los aromas del café de especialidad.',
  },
  {
    title: 'Cómo preparar un buen café en casa',
    href: 'blog/articulo-2/',
    description: 'Aprende algunos consejos para disfrutar de un café delicioso en casa.',
  },
];
---

<BaseLayout
  title="Blog | Café Pedro"
  description="Descubre artículos, consejos y curiosidades sobre el café, su preparación y sus aromas."
>
  <h1>Blog de Café Pedro</h1>

  <ul>
    {articulos.map((articulo) => (
      <li>
        <a href={`${base}${articulo.href}`}>{articulo.title}</a>
        <p>{articulo.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>